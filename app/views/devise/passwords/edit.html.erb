<h2>Escolher nova senha</h2>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>
  <%= f.hidden_field :reset_password_token %>

  <%= f.label :password, "Nova senha" %>
  <%= f.password_field :password, autofocus: true, autocomplete: "new-password", required: true %>
  <% if @minimum_password_length %>
    <small>Mínimo de <%= @minimum_password_length %> caracteres.</small>
  <% end %>

  <%= f.label :password_confirmation, "Repetir a nova senha" %>
  <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true %>

  <%= f.submit "Trocar minha senha" %>
<% end %>

<%= render "devise/shared/links" %>
