<%= form_with model: [:admin, client] do |f| %>
  <% if client.errors.any? %>
    <div class="flash flash--alert" id="error_explanation">
      <strong><%= pluralize(client.errors.count, "erro") %> impediu(ram) o salvamento:</strong>
      <ul>
        <% client.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= f.label :name, "Nome" %>
  <%= f.text_field :name, required: true %>

  <%= f.label :email %>
  <%= f.email_field :email %>

  <%# --- início: campos nossos (vêm preenchidos quando o cadastro sai da prospecção) --- %>
  <%= f.label :phone, "Telefone" %>
  <%= f.telephone_field :phone %>

  <%= f.label :address, "Endereço" %>
  <%= f.text_field :address %>

  <%= f.label :website, "Site" %>
  <%= f.url_field :website %>

  <%# Sem campo visível: é identidade do negócio no Google, não dado editável. %>
  <%= f.hidden_field :google_place_id %>
  <%# --- fim: campos nossos --- %>

  <%= f.submit %>
<% end %>
