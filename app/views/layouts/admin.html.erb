<%# --- início: layout nosso (painel admin: Pico + sidebar fixa + flash) --- %>
<%# Separado de application.html.erb de propósito: a LP pública não carrega o CSS
    do painel (e vice-versa), então os dois lados podem evoluir sem brigar. %>
<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title><%= content_for(:title) || "Painel — Landing Pages Hub" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <%# Transição entre páginas do painel: nativa do navegador, ligada pelo Turbo
        com esta meta tag. Sem lib de animação. %>
    <meta name="view-transition" content="same-origin">

    <%= stylesheet_link_tag "pico.min", "admin", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div class="admin-shell">
      <aside class="admin-sidebar">
        <h1>Landing Pages Hub</h1>

        <nav>
          <ul>
            <%# Os links de listagem carregam o último filtro usado (session):
                trocar de aba e voltar não obriga a refazer a busca. %>
            <li><%= link_to admin_root_path, "aria-current": ("page" if current_page?(admin_root_path)) do %>
              <%= icon(:painel) %> Painel
            <% end %></li>
            <li><%= link_to admin_clients_path(remembered_filters(:clients)), "aria-current": ("page" if controller_name == "clients" || controller_name == "landing_pages") do %>
              <%= icon(:clientes) %> Clientes
            <% end %></li>
            <li><%= link_to admin_prospects_path(remembered_filters(:prospects)), "aria-current": ("page" if controller_name == "prospects") do %>
              <%= icon(:busca) %> Prospecção
            <% end %></li>
          </ul>
        </nav>

        <footer>
          <%= current_admin.email %>
          <%= button_to destroy_admin_session_path, method: :delete, class: "secondary outline" do %>
            <%= icon(:sair) %> Sair
          <% end %>
        </footer>
      </aside>

      <main class="admin-content">
        <% flash.each do |type, message| %>
          <div class="flash flash--<%= type %>" role="status"><%= message %></div>
        <% end %>

        <%= yield %>
      </main>
    </div>
  </body>
</html>
<%# --- fim: layout nosso --- %>
